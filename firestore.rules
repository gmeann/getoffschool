rules_version = '2';

// 퇴근길 학교 보안 규칙
// 원칙: 클라이언트가 보낸 값을 믿지 않는다. 허용한 필드·값·변화량만 통과시킨다.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 ----------
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function data() { return request.resource.data; }
    function old() { return resource.data; }

    // 문자열 길이(글자 수)와 줄바꿈 금지
    function textOk(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen && !v.matches('(?s).*[\\r\\n].*');
    }

    // 도배 방지: 같은 요청(batch)에서 users/{uid}.lastWriteAt 을 서버 시각으로 갱신해야 하고,
    // 그 갱신은 users 규칙에서 "이전 쓰기 후 30초 지남"을 검사함
    function userDoc() { return /databases/$(database)/documents/users/$(me()); }
    function gateTouched() { return getAfter(userDoc()).data.lastWriteAt == request.time; }

    // 글 수정은 아래 두 경우만: 반응(+1/-1), 신고(+1, 3건 이상이면 숨김)
    function onlyChanged(keys) { return data().diff(old()).affectedKeys().hasOnly(keys); }

    // 관리자: Firebase 콘솔에서 만든 admins/{uid} 문서가 있는 (익명이 아닌) 계정
    function isAdmin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(/databases/$(database)/documents/admins/$(me()));
    }
    // 관리자 되살리기: 숨김 해제 + 신고 수 0 (다른 필드는 못 바꿈)
    function adminRestore() {
      return isAdmin() && onlyChanged(['hidden', 'reportCount']) && data().hidden == false && data().reportCount == 0;
    }

    // ---------- 관리자 목록 (콘솔에서만 만들 수 있음) ----------
    match /admins/{adminId} {
      allow get: if signedIn() && adminId == me();
      allow list, write: if false;
    }

    // ---------- 사용자별 마지막 글쓰기 시각 ----------
    match /users/{userId} {
      allow read: if signedIn() && userId == me();
      allow create, update: if signedIn() && userId == me()
        && data().keys().hasOnly(['lastWriteAt'])
        && data().lastWriteAt == request.time
        && (resource == null || request.time > old().lastWriteAt + duration.value(30, 's'));
      allow delete: if false;
    }

    // ---------- 연구실 게시판 글 ----------
    match /posts/{postId} {
      function postPath() { return /databases/$(database)/documents/posts/$(postId); }
      function reactionPath() { return /databases/$(database)/documents/posts/$(postId)/reactions/$(me()); }
      function reportPath() { return /databases/$(database)/documents/posts/$(postId)/reports/$(me()); }

      // 목록 조회는 숨김이 아닌 글만 (쿼리에 hidden == false 조건이 있어야 통과)
      allow get: if signedIn();
      allow list: if signedIn() && (resource.data.hidden == false || isAdmin());

      allow create: if signedIn()
        && data().keys().hasOnly(['board', 'text', 'color', 'reason', 'nick', 'uid', 'createdAt', 'reactionCount', 'reportCount', 'hidden'])
        && data().keys().hasAll(['board', 'text', 'nick', 'uid', 'createdAt', 'reactionCount', 'reportCount', 'hidden'])
        && data().board in ['memo', 'fridge', 'blackboard']
        && textOk(data().text, 1, 60)
        && textOk(data().nick, 1, 20)
        && data().uid == me()
        && data().reactionCount == 0
        && data().reportCount == 0
        && data().hidden == false
        && data().createdAt == request.time
        && (!('color' in data()) || (data().board == 'memo' && data().color in ['yellow', 'pink', 'mint', 'sky']))
        && (!('reason' in data()) || (data().board == 'fridge' && textOk(data().reason, 1, 40)))
        && gateTouched();

      allow update: if signedIn() && (
        adminRestore()
        ||
        // 반응 +1: 내 반응 문서를 새로 만들 때만
        (onlyChanged(['reactionCount'])
          && data().reactionCount == old().reactionCount + 1
          && !exists(reactionPath()) && existsAfter(reactionPath()))
        ||
        // 반응 취소 -1: 내 반응 문서를 지울 때만
        (onlyChanged(['reactionCount'])
          && data().reactionCount == old().reactionCount - 1
          && exists(reactionPath()) && !existsAfter(reactionPath()))
        ||
        // 신고 +1: 내 신고 문서를 새로 만들 때만, 3건 이상이면 숨김
        (onlyChanged(['reportCount', 'hidden'])
          && data().reportCount == old().reportCount + 1
          && data().hidden == (old().hidden || data().reportCount >= 3)
          && !exists(reportPath()) && existsAfter(reportPath()))
      );

      allow delete: if signedIn() && (old().uid == me() || isAdmin());

      match /reactions/{userId} {
        allow read: if signedIn() && userId == me();
        allow create: if signedIn() && userId == me()
          && data().keys().hasOnly(['createdAt']) && data().createdAt == request.time
          && getAfter(postPath()).data.reactionCount == get(postPath()).data.reactionCount + 1;
        allow delete: if signedIn() && userId == me()
          && getAfter(postPath()).data.reactionCount == get(postPath()).data.reactionCount - 1;
        allow update: if false;
      }

      match /reports/{userId} {
        allow read: if signedIn() && userId == me();
        allow create: if signedIn() && userId == me()
          && data().keys().hasOnly(['createdAt']) && data().createdAt == request.time
          && getAfter(postPath()).data.reportCount == get(postPath()).data.reportCount + 1;
        allow update, delete: if false;
      }
    }

    // ---------- 마음 나누기 (하늘의 구름) ----------
    match /hearts/{heartId} {
      function heartPath() { return /databases/$(database)/documents/hearts/$(heartId); }
      function myReactionPath() { return /databases/$(database)/documents/hearts/$(heartId)/reactions/$(me()); }
      function myReportPath() { return /databases/$(database)/documents/hearts/$(heartId)/reports/$(me()); }

      allow get: if signedIn();
      allow list: if signedIn() && (resource.data.hidden == false || isAdmin());

      allow create: if signedIn()
        && data().keys().hasOnly(['text', 'nick', 'uid', 'createdAt', 'pat', 'thanks', 'together', 'reportCount', 'hidden'])
        && data().keys().hasAll(['text', 'nick', 'uid', 'createdAt', 'pat', 'thanks', 'together', 'reportCount', 'hidden'])
        && textOk(data().text, 1, 100)
        && textOk(data().nick, 1, 20)
        && data().uid == me()
        && data().pat == 0 && data().thanks == 0 && data().together == 0
        && data().reportCount == 0
        && data().hidden == false
        && data().createdAt == request.time
        && gateTouched();

      allow update: if signedIn() && (
        adminRestore()
        ||
        // 반응 +1: 새로 만든 내 반응 문서의 종류(kind) 칸만 1 증가
        (existsAfter(myReactionPath()) && !exists(myReactionPath())
          && onlyChanged([getAfter(myReactionPath()).data.kind])
          && data()[getAfter(myReactionPath()).data.kind] == old()[getAfter(myReactionPath()).data.kind] + 1)
        ||
        // 반응 취소 -1: 지우는 내 반응 문서의 종류 칸만 1 감소
        (exists(myReactionPath()) && !existsAfter(myReactionPath())
          && onlyChanged([get(myReactionPath()).data.kind])
          && data()[get(myReactionPath()).data.kind] == old()[get(myReactionPath()).data.kind] - 1)
        ||
        // 신고 +1, 3건 이상이면 숨김
        (onlyChanged(['reportCount', 'hidden'])
          && data().reportCount == old().reportCount + 1
          && data().hidden == (old().hidden || data().reportCount >= 3)
          && !exists(myReportPath()) && existsAfter(myReportPath()))
      );

      allow delete: if signedIn() && (old().uid == me() || isAdmin());

      match /reactions/{userId} {
        allow read: if signedIn() && userId == me();
        allow create: if signedIn() && userId == me()
          && data().keys().hasOnly(['kind', 'createdAt'])
          && data().kind in ['pat', 'thanks', 'together']
          && data().createdAt == request.time
          && getAfter(heartPath()).data[data().kind] == get(heartPath()).data[data().kind] + 1;
        allow delete: if signedIn() && userId == me()
          && getAfter(heartPath()).data[old().kind] == get(heartPath()).data[old().kind] - 1;
        allow update: if false;
      }

      match /reports/{userId} {
        allow read: if signedIn() && userId == me();
        allow create: if signedIn() && userId == me()
          && data().keys().hasOnly(['createdAt']) && data().createdAt == request.time
          && getAfter(heartPath()).data.reportCount == get(heartPath()).data.reportCount + 1;
        allow update, delete: if false;
      }
    }

    // ---------- 공유 카운터 ----------
    // 한 번에 늘릴 수 있는 범위: 0~50 (감소·임의 값 설정 불가)
    function incOk(key, maxStep) {
      let before = resource == null ? 0 : old().get(key, 0);
      let after = data().get(key, 0);
      return after is int && after - before >= 0 && after - before <= maxStep;
    }

    // 날짜별 문서: daily/{YYYY-MM-DD} = { flung, laps, visitors }
    match /daily/{date} {
      function visitPath() { return /databases/$(database)/documents/visits/$(date)/users/$(me()); }
      allow read: if signedIn();
      allow create, update: if signedIn()
        && date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data().keys().hasOnly(['flung', 'laps', 'visitors'])
        && incOk('flung', 50)
        && incOk('laps', 50)
        && incOk('visitors', 1)
        // 방문자 수는 오늘 내 방문 기록을 처음 만들 때만 +1
        && (data().get('visitors', 0) == (resource == null ? 0 : old().get('visitors', 0))
            || (existsAfter(visitPath()) && !exists(visitPath())));
      allow delete: if false;
    }

    // 전체 누적: counters/total = { flung }
    match /counters/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && id == 'total'
        && data().keys().hasOnly(['flung'])
        && incOk('flung', 50);
      allow delete: if false;
    }

    // 방문 기록: 사용자당 하루 1회만 만들 수 있음 (수정·삭제 불가)
    match /visits/{date}/users/{userId} {
      function dailyPath() { return /databases/$(database)/documents/daily/$(date); }
      allow read: if signedIn() && userId == me();
      allow create: if signedIn() && userId == me()
        && date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data().keys().hasOnly(['createdAt']) && data().createdAt == request.time
        && getAfter(dailyPath()).data.get('visitors', 0) == (exists(dailyPath()) ? get(dailyPath()).data.get('visitors', 0) : 0) + 1;
      allow update, delete: if false;
    }

    // 그 밖의 모든 경로는 막음
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
